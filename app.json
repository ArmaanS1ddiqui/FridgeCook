{
  "expo": {
    "name": "FridgeCook",
    "slug": "armaanical",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "fridgeapp",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FridgeApp needs camera access to scan grocery receipts",
        "NSPhotoLibraryUsageDescription": "FridgeApp needs photo library access to import grocery receipt images"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "package": "com.armaansiddiqui.fridgecook",
      "predictiveBackGestureEnabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/89b8005b-4473-4f0d-a120-33c94e33c6c3"
    },
    "extra": {
      "eas": {
        "projectId": "89b8005b-4473-4f0d-a120-33c94e33c6c3"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "FridgeApp needs camera access to scan grocery receipts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FridgeApp needs photo library access to import grocery receipt images"
        }
      ]
    ]
  }
}
